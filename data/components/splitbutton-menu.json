        "title": "Vue · PrimeVue 4",
        "code": "<template>\n  <Button label=\"Nueva conexión\" icon=\"pi pi-chevron-down\" iconPos=\"right\"\n          aria-haspopup=\"true\" aria-controls=\"menu-nueva-conexion\"\n          @click=\"menu.toggle($event)\" />\n  <Menu ref=\"menu\" id=\"menu-nueva-conexion\" :model=\"opciones\" :popup=\"true\">\n    <template #item=\"{ item }\">\n      <div class=\"flex items-start gap-2 px-2 py-1.5\">\n        <i v-if=\"item.icon\" :class=\"item.icon\" />\n        <div>\n          <span class=\"text-body-xs\">{{ item.label }}</span>\n          <p v-if=\"item.description\" class=\"text-body-xxs-regular\">{{ item.description }}</p>\n        </div>\n      </div>\n    </template>\n  </Menu>\n</template>\n\n<script setup>\nimport { ref } from 'vue'\nconst menu = ref()\nconst opciones = [\n  { label: 'WhatsApp',  icon: 'pi pi-whatsapp',  command: () => {} },\n  { label: 'Facebook',  icon: 'pi pi-facebook',  command: () => {} },\n  { label: 'Instagram', icon: 'pi pi-instagram', disabled: true,\n    description: 'Límite de tu plan alcanzado' },\n]\n</script>"
      }
